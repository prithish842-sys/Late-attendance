# Copy to .env and fill in real values (never commit .env).
# These come from: Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# true routes report requests to the generateReport HttpsCallable (Blaze);
# false (default) enqueues report_requests for scripts/generate-report.js (Spark).
VITE_BLAZE_ENABLED=false