# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file — see SECURITY.md and .gitignore.

# ── Firebase (client config — safe to expose in app, but keep in .env for consistency) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Cloud Functions only — NEVER expose these to the Flutter app or the web client ──
RESEND_API_KEY=
GEMINI_API_KEY=

# ── App settings (defaults — actual values should live in Firestore `settings` doc, see ARCHITECTURE.md) ──
DEFAULT_LATE_CUTOFF_TIME=09:15
DEFAULT_ESCALATION_THRESHOLD=3
DEFAULT_RESET_PERIOD=monthly
