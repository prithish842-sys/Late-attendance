# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file — see SECURITY.md and .gitignore.

# ── Firebase (client config — safe to expose in app, but keep in .env for consistency) ──
# FIREBASE_API_KEY must be the *web* API key (lib/firebase_options.dart →
# DefaultFirebaseOptions.web). Scripts call the Identity Toolkit REST API with it
# and the Android key is app-restricted, so it gets rejected there.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Cloud Functions only — NEVER expose these to the Flutter app or the web client ──
RESEND_API_KEY=
GEMINI_API_KEY=

# ── Mail runner (scripts/process-mail.js on Spark) / Cloud Functions (Blaze) ──
# RESEND_API_KEY above is the secret; the three below are just sender/Brand copy
# and are optional (sensible defaults exist in functions/mail-sender.js).
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
COLLEGE_NAME=

# ── Real accounts (single source of truth — scripts read these; never hardcode elsewhere) ──
# Real PT Sir / Admin accounts (see NEW_DECISIONS.md #19). HOD has no login (#16);
# the HOD mail recipients live only in seed/departments.json → departments.hodEmail.
# PT Sir login account (real; fill your local copy — never commit real values).
FIREBASE_DEMO_PT_SIR_EMAIL=
FIREBASE_DEMO_PT_SIR_PASSWORD=
FIREBASE_DEMO_PT_SIR_ROLE=pt_sir
# Admin account (real; fill your local copy).
FIREBASE_DEMO_ADMIN_EMAIL=
FIREBASE_DEMO_ADMIN_PASSWORD=
FIREBASE_DEMO_ADMIN_ROLE=admin

# ── App settings (defaults — actual values should live in Firestore `settings` doc, see ARCHITECTURE.md) ──
DEFAULT_LATE_CUTOFF_TIME=09:15
DEFAULT_ESCALATION_THRESHOLD=3
DEFAULT_RESET_PERIOD=monthly

# Firebase CLI OAuth client secret used by scripts/lib/firebase-rest.js
# (refresh-token flow). Source never contains it - C2.
FIREBASE_CLI_CLIENT_SECRET=
